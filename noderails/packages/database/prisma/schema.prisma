// ============================================================================
// EMAIL DELIVERIES
// ============================================================================

/// Tracks email delivery attempts for payment receipts and notifications
model EmailDelivery {
  id              String              @id @default(uuid())
  paymentIntentId String?
  invoiceId       String?
  payoutIntentId  String?
  templateId      String              @db.VarChar(100)
  recipientEmail  String

  status          EmailDeliveryStatus @default(PENDING)
  attempts        Int                 @default(0)
  lastError       String?             @db.Text

  /// SES message ID on successful send
  messageId       String?

  /// Bounce / complaint metadata from SES notifications
  bounceType      String?             @db.VarChar(50)
  bounceSubType   String?             @db.VarChar(50)
  complaintType   String?             @db.VarChar(100)
  diagnosticCode  String?             @db.Text

  sentAt          DateTime?
  deliveredAt     DateTime?
  bouncedAt       DateTime?
  complainedAt    DateTime?
  failedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  paymentIntent   PaymentIntent?      @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  invoice         Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payoutIntent    PayoutIntent?       @relation(fields: [payoutIntentId], references: [id], onDelete: Cascade)

  @@unique([paymentIntentId, templateId])
  @@index([paymentIntentId])
  @@index([invoiceId])
  @@index([payoutIntentId])
  @@index([status])
  @@index([messageId])
  @@map("email_deliveries")
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

/// Global email suppression list — prevents sending to addresses that
/// have permanently bounced or filed spam complaints.
model EmailSuppression {
  id        String                  @id @default(uuid())
  email     String                  @unique
  reason    EmailSuppressionReason
  detail    String?                 @db.Text
  createdAt DateTime                @default(now())

  @@map("email_suppressions")
}

enum EmailSuppressionReason {
  PERMANENT_BOUNCE
  COMPLAINT
  CAMPAIGN_UNSUBSCRIBE
}

enum EmailListContactSource {
  TYPED
  CSV
}

enum EmailCampaignAudience {
  EVERYONE
  REGISTERED_ACCOUNTS
  ADDED_CONTACTS
  SELECTED_PEOPLE
  BUCKETS
}

enum EmailCampaignStatus {
  DRAFT
  QUEUED
  SENDING
  CANCELLED
  COMPLETED
}

enum EmailCampaignRecipientSource {
  REGISTERED
  ADDED
  TEST
}

enum EmailCampaignRecipientStatus {
  PENDING
  SKIPPED
  SENT
  FAILED
  CANCELLED
}

enum EmailCampaignTemplate {
  UPDATES
  BUSINESS_OUTREACH
  DIRECT_OUTREACH
  PARTNERSHIP
  EVENT_INVITE
  ANNOUNCEMENT
  FOLLOW_UP
}

/// Extra campaign contacts added by admin (typed or CSV). Not merchants.
model EmailListContact {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  name                String?                @db.VarChar(120)
  source              EmailListContactSource
  createdByAdminEmail String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  recipients          EmailCampaignRecipient[]

  @@map("email_list_contacts")
}

model EmailCampaign {
  id                  String                @id @default(uuid())
  subject             String
  heading             String
  body                String                @db.Text
  ctaLabel            String?
  ctaUrl              String?
  /// Structured buttons: [{ id, label, url, placement, style, align?, withArrow? }]
  ctas                Json?
  /// stack = one per row; row = side by side within a placement
  ctaLayout           String                @default("stack") @db.VarChar(16)
  showBackedBy        Boolean               @default(true)
  signerName          String?
  signerTitle         String?
  fromAddress         String
  templateId          EmailCampaignTemplate @default(UPDATES)
  audience            EmailCampaignAudience
  selectedPersonKeys  Json?
  selectedBucketIds   Json?
  status              EmailCampaignStatus   @default(DRAFT)
  recipientCount      Int                   @default(0)
  sentCount           Int                   @default(0)
  skippedCount        Int                   @default(0)
  failedCount         Int                   @default(0)
  uniqueOpens         Int                   @default(0)
  totalOpens          Int                   @default(0)
  uniqueClicks        Int                   @default(0)
  totalClicks         Int                   @default(0)
  createdByAdminEmail String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  startedAt           DateTime?
  completedAt         DateTime?

  recipients          EmailCampaignRecipient[]
  clicks              EmailCampaignClick[]

  @@index([status])
  @@index([createdAt])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id             String                       @id @default(uuid())
  campaignId     String
  email          String
  displayName    String?
  merchantId     String?
  listContactId  String?
  source         EmailCampaignRecipientSource
  status         EmailCampaignRecipientStatus @default(PENDING)
  openToken      String                       @unique
  firstOpenedAt  DateTime?
  lastOpenedAt   DateTime?
  openCount      Int                          @default(0)
  firstClickedAt DateTime?
  lastClickedAt  DateTime?
  clickCount     Int                          @default(0)
  emailDeliveryId String?
  lastError      String?                      @db.Text
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  campaign       EmailCampaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  merchant       Merchant?                    @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  listContact    EmailListContact?            @relation(fields: [listContactId], references: [id], onDelete: SetNull)
  clicks         EmailCampaignClick[]

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([merchantId])
  @@map("email_campaign_recipients")
}

model EmailCampaignClick {
  id          String                 @id @default(uuid())
  campaignId  String
  recipientId String
  email       String
  url         String
  ctaId       String?
  ctaLabel    String?
  createdAt   DateTime               @default(now())

  campaign    EmailCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient   EmailCampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([recipientId])
  @@index([campaignId, ctaId])
  @@map("email_campaign_clicks")
}

/// Admin-created tag for campaign people. Membership is email-based so
/// registered merchants and added contacts share the same buckets.
model EmailBucket {
  id                  String              @id @default(uuid())
  name                String              @db.VarChar(80)
  slug                String              @unique @db.VarChar(80)
  createdByAdminEmail String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  members             EmailBucketMember[]

  @@map("email_buckets")
}

model EmailBucketMember {
  id        String      @id @default(uuid())
  bucketId  String
  email     String
  createdAt DateTime    @default(now())

  bucket    EmailBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@unique([bucketId, email])
  @@index([email])
  @@map("email_bucket_members")
}
