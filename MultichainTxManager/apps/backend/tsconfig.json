{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "paths": {
      "@/*": ["./src/*"],
      "@mtxm/shared": ["../../packages/shared/src/index.ts"],
      "@mtxm/shared/*": ["../../packages/shared/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
